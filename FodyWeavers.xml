<?xml version="1.0" encoding="utf-8" ?>
<Weavers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="FodyWeavers.xsd">
	<!-- CreateTemporaryAssemblies 必须为 false：为 true 时 Costura 会把 AntdUI 解包到临时目录再
	     Assembly.LoadFile，程序从网络位置/带 Internet 标记的目录启动时会被判定为远程程序集而拒绝加载
	     （FileLoadException），必须靠 exe.config 里的 loadFromRemoteSources 才能放行。
	     设成 false 后直接从内存加载内嵌程序集，单文件 exe 照旧可用，无需任何配置文件。 -->
	<Costura CreateTemporaryAssemblies="false" />
</Weavers>
